# Образец файла .env. Скопируйте в .env и подставьте свои значения.
#
# Сам .env в репозиторий не попадает (он в .gitignore), а этот файл —
# попадает: по нему видно, какие переменные нужны, и при развёртывании
# ничего не приходится вспоминать.
#
# ЗДЕСЬ ТОЛЬКО СЕКРЕТЫ И ТО, ЧТО РАЗЛИЧАЕТСЯ МЕЖДУ МАШИНАМИ.
# Всё остальное живёт в коде со значениями по умолчанию: хост базы,
# её имя, порт приложения. Прятать их незачем, а держать в двух местах
# — значит однажды поменять одно и забыть другое.

# --- Учётные записи персонала (вход на /admin) ---
FC_ADMIN_PASSWORD=
FC_MANAGER_PASSWORD=

# --- База данных: учётная запись приложения ---
# Под ней магазин работает каждый день. Роль создаётся командой
# --create и становится владельцем базы; прав за пределами своей базы
# у неё нет, поэтому ошибка в коде не заденет остальные.
FC_DB_USER=fructcity
# ↓ ПРИДУМАЙТЕ САМИ: любой пароль для роли магазина.
#   Впишите его сразу после знака «равно», без пробелов и без
#   комментария в той же строке — иначе он попадёт в пароль.
FC_DB_PASSWORD=

# --- База данных: административная запись ---
# Нужна РОВНО ОДИН РАЗ, чтобы создать роль выше и саму базу. Создать
# базу, находясь в ней самой, нельзя: надо подключиться к служебной
# базе postgres под записью, которой это позволено.
#
# Это пароль суперпользователя PostgreSQL — тот, что задавали при
# установке. После `--create` обе строки можно стереть.
FC_DB_ADMIN_USER=postgres
# ↓ Пароль суперпользователя, заданный при установке PostgreSQL.
FC_DB_ADMIN_PASSWORD=

# Переопределяйте, только если у вас иначе:
# FC_DB_HOST=127.0.0.1
# FC_DB_PORT=5432
# FC_DB_NAME=fructcity
# FC_DB_ADMIN_DB=postgres

# Готовая строка целиком — так адрес базы выдают Docker и облачные
# хостинги. Если задана, отменяет всё, что выше.
# DATABASE_URL=

# --- Порт и адрес приложения ---
PORT=3000
HOST=127.0.0.1

# --- Режим ---
# production — cookie станут Secure и потребуют HTTPS,
# документация API перестанет подниматься.
NODE_ENV=development

# --- Код из SMS прямо в ответе API ---
# Удобно, пока не подключён SMS-провайдер. В продакшене обязательно
# убрать: иначе войти в чужой кабинет можно, зная только номер.
FC_DEV_OTP=1

# --- Telegram (необязательно) ---
# Без секрета вебхук привязки отключён и отдаёт 503.
# FC_TELEGRAM_BOT=
# FC_TELEGRAM_SECRET=

# --- Где хранить данные ---
# По умолчанию — папка data рядом с проектом.
# FC_DATA_DIR=
