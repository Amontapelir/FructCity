# Не попадает в контекст сборки образа — как .gitignore, но для Docker.
# Секреты и персональные данные сюда особенно важны: попав в слой образа,
# они разойдутся с любым, кто этот образ скачает.

.git/
.gitignore
.gitattributes

.venv/
__pycache__/
*.pyc

.idea/
.vscode/

.env
data/

docs/
CLAUDE.md

# Тесты и CI не нужны внутри образа — только код приложения.
backend/tests/
.github/
