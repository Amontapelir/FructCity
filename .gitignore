# Секреты. В репозиторий уходит только .env.example — шаблон без значений.
.env

# Данные магазина. Здесь лежат заказы: имена, телефоны, адреса, почта.
# Персональные данные в истории правок — это навсегда: удалить их потом
# нельзя, можно только переписывать историю целиком. Сюда же попадают
# резервные копии store.json.before-cutover-* по той же причине.
#
# Боевые данные живут в PostgreSQL, их бережёт бэкап базы, а не git.
data/

# Виртуальное окружение: сотни мегабайт чужого кода, который ставится
# одной командой из backend/requirements.txt.
.venv/
venv/

# Байткод Python. Пересобирается сам, различается между версиями.
__pycache__/
*.py[cod]

# Временные базы, которые оставляют после себя тесты и ручные прогоны.
*.db
*.sqlite
*.sqlite3

# Журналы.
*.log

# Настройки IDE — они про машину разработчика, а не про проект.
.idea/
.vscode/

# Мусор файловых менеджеров.
.DS_Store
Thumbs.db

# Внутренние рабочие документы — по решению владельца проекта не
# публикуются. Они остаются на диске и продолжают править работу, но в
# историю и на GitHub не уходят.
#
# ВАЖНО, чем это оплачено: у них не будет ни истории правок, ни копии
# нигде, кроме этого диска. Потеря диска — потеря архитектурных решений,
# описания инвариантов и причин, по которым код такой, какой он есть.
# Восстановить это по самому коду нельзя. Если понадобится вернуть их
# под версионирование — убрать эти строки и `git add`.
CLAUDE.md
docs/
